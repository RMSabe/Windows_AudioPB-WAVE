<local:MyPage
	x:Class="AudioPlayback.ChooseAudioDevicePage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
	xmlns:local="clr-namespace:AudioPlayback"
	mc:Ignorable="d">

	<Grid>
		<TextBlock
			Name="TextBlock1"
			HorizontalAlignment="Center"
			VerticalAlignment="Top"
			Margin="20px"
			FontSize="35px"
			TextAlignment="Center"
			Text="Select Audio Device"/>

		<ListBox
			Name="ListBox1"
			HorizontalAlignment="Center"
			VerticalAlignment="Top"
			Width="600px"
			Height="60px"
			Margin="100px"
			SelectionMode="Single"/>

		<Button
			Name="Button_Cancel"
			HorizontalAlignment="Center"
			VerticalAlignment="Bottom"
			Width="200px"
			Height="20px"
			Margin="120px"
			Content="Cancel"
			Click="onButtonCancelClicked"/>

		<Button
			Name="Button_ChooseSelected"
			HorizontalAlignment="Center"
			VerticalAlignment="Bottom"
			Width="200px"
			Height="20px"
			Margin="90px"
			Content="Choose Selected Device"
			Click="onButtonChooseSelectedClicked"/>

		<Button
			Name="Button_ChooseDefault"
			HorizontalAlignment="Center"
			VerticalAlignment="Bottom"
			Width="200px"
			Height="20px"
			Margin="60px"
			Content="Choose Default Device"
			Click="onButtonChooseDefaultClicked"/>
	</Grid>
</local:MyPage>
